# ---------------------------------------------------------------------------
# WATTWISE DZ — configuration template. Copy to .env before starting.
# ---------------------------------------------------------------------------

# --- Optional host port overrides (docker-compose) --------------------------
# Defaults match the specification (5432 and 8000). Uncomment and change if
# those host ports are already occupied on your machine.
# POSTGRES_PORT=5432
# BACKEND_PORT=8000

# --- PostgreSQL -------------------------------------------------------------
# Async SQLAlchemy URL used by the backend container. Host "postgres" is the
# docker-compose service name.
DATABASE_URL=postgresql+asyncpg://wattwise:wattwise_dev@postgres:5432/wattwise

# Dedicated database for pytest. Created automatically by tests/conftest.py.
# Inside Docker the host is "postgres"; from the host machine use "localhost".
TEST_DATABASE_URL=postgresql+asyncpg://wattwise:wattwise_dev@postgres:5432/wattwise_test

# --- MQTT broker (backend) --------------------------------------------------
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC=wattwise/+/data
# Optional advanced PV telemetry topic. Payloads published here are stored in
# `pv_readings` and trigger the rule-based PV diagnostics asynchronously.
MQTT_SOLAR_TOPIC=wattwise/+/solar
MQTT_KEEPALIVE=60

# --- Simulator (runs on the host) -------------------------------------------
# "localhost" works when simulator.py runs outside Docker; set to "mosquitto"
# if you instead run the simulator inside a container on the compose network.
SIMULATOR_MQTT_HOST=localhost
SIMULATOR_MQTT_PORT=1883
SIMULATOR_DEVICE_ID=SALLE1
SIMULATOR_INTERVAL_SECONDS=10
# Probability per cycle of injecting a "stuck fan" while unoccupied (demo aid).
SIMULATOR_FAULT_PROBABILITY=0.15

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Photovoltaic plant (advanced PV monitoring) ----------------------------
# All values are datasheet/installation parameters used to compute the
# irradiance-based expected power. They are NOT live measurements.
PV_DEVICE_ID=PV1
PV_PANEL_AREA_M2=34
PV_PANEL_EFFICIENCY=0.195
PV_PEAK_KW=6.5
# Power temperature coefficient (per °C) and STC cell temperature.
PV_TEMP_COEFFICIENT_PER_C=-0.004
PV_STC_TEMPERATURE_C=25
# Nominal Operating Cell Temperature, used to estimate cell temperature.
PV_NOCT_C=45
# Measurements older than this are flagged `is_stale` in the API.
PV_STALE_AFTER_MINUTES=30

# --- PV / inverter diagnostic thresholds ------------------------------------
# Actual power below this fraction of expected power counts as
# underperformance (only evaluated above the irradiance/power floors).
PV_UNDERPERFORMANCE_RATIO=0.80
PV_MIN_IRRADIANCE_WM2=500
PV_MIN_EXPECTED_POWER_W=50
# Consecutive readings required before a persistent fault is raised.
PV_CONSECUTIVE_READINGS=3
PV_MAX_PANEL_TEMPERATURE_C=70
PV_INVERTER_MIN_EFFICIENCY_PCT=90
PV_INVERTER_MAX_TEMPERATURE_C=65
# Minimum minutes between two notifications for the same active fault
# (prevents duplicate alerts while the anomaly persists).
PV_FAULT_RENOTIFY_MINUTES=30

# --- Energy-source optimizer (battery / grid / solar) -----------------------
# Battery state of charge is SIMULATED until a BMS is connected.
BATTERY_CAPACITY_KWH=10
BATTERY_MIN_SOC_PERCENT=20
BATTERY_MAX_SOC_PERCENT=95
BATTERY_CHARGE_LIMIT_KW=3
BATTERY_DISCHARGE_LIMIT_KW=3
BATTERY_ROUND_TRIP_EFFICIENCY=0.90
BATTERY_DEFAULT_SOC_PERCENT=62
# Grid charging during cheap hours is disabled by default.
BATTERY_ALLOW_GRID_CHARGING=false
# Documented default tariff (Sonelgaz residential average). No dynamic /
# time-of-use tariff is assumed unless you set it yourself.
GRID_TARIFF_DZD_PER_KWH=5.5
# Feed-in is disabled: no verified Algerian export tariff is assumed.
GRID_EXPORT_ENABLED=false
GRID_EXPORT_TARIFF_DZD_PER_KWH=0
GRID_CO2_FACTOR_KG_PER_KWH=0.45

# --- Groq API for WATTY AI agent ---
GROQ_API_KEY=your_groq_api_key_here
